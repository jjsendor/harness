# Copy to .env in the directory from which you launch the harness.
OPENAI_API_KEY=
HARNESS_MODEL=gpt-4.1-mini

# Set HARNESS_TRACING=false to run without Langfuse.
HARNESS_TRACING=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Per invocation limits; SDK retries can add underlying HTTP requests.
HARNESS_MAX_MODEL_CALLS=20
HARNESS_MAX_TOOL_CALLS=40
HARNESS_MODEL_TIMEOUT_SECONDS=60
HARNESS_TEST_TIMEOUT_SECONDS=60
